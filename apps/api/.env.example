SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# LLM Provider configuration (Gemini default, swappable via env)
LLM_PROVIDER=gemini
LLM_AGENT_MODEL=gemini-2.5-flash
LLM_FAST_MODEL=gemini-1.5-flash

# Google Gemini configuration
GEMINI_API_KEY=AIzaSy-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Server settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:19006"]

# Voice transcription configuration
TRANSCRIPTION_PROVIDER=whisper
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Day 3 Search Slice configuration
