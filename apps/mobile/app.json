{
  "expo": {
    "name": "Recruiting Platform",
    "slug": "recruiting-platform",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "recruiting",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.wildcatter.recruiting",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4dc6cc4c-606e-4b4a-89f8-38d1092fc964"
      }
    },
    "owner": "00ac2005"
  }
}
